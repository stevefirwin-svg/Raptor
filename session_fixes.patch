+            max_consec_loss = max(max_consec_loss, cur_consec)
+        else:
+            cur_consec = 0
+    current_streak = cur_consec  # still ongoing if last trade was a loss
+
+    # ── H-4: Capital efficiency (realized PnL / max capital deployed) ─────────
